{
  "name": "applemusicrpc",
  "productName": "AppleMusicRPC",
  "version": "1.1.0",
  "description": "Discord Rich Presence for Apple Music on macOS and iTunes on Windows",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack:mac": "electron-packager . AppleMusicRPC --out=dist --platform=darwin --arch=universal --icon=icons/icon.icns --overwrite",
    "pack:win64": "electron-packager . AppleMusicRPC --out=dist --platform=win32 --arch=x64 --icon=icons/icon.ico --overwrite",
    "pack:win-arm64": "electron-packager . AppleMusicRPC --out=dist --platform=win32 --arch=arm64 --icon=icons/icon.ico --overwrite",
    "build": "npm run pack:win64 && npm run pack:win-arm64 && npm run pack:mac"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.4.1"
  }
}
